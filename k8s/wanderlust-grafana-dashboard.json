{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Production Kubernetes & Node Observability Dashboard for Wanderlust on AWS EKS",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Application Health - Wanderlust Pods",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Healthy Replicas",
      "description": "Counts active, healthy Wanderlust pods currently serving web traffic. Target is 3/3 replicas for high availability and zero downtime.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(kube_deployment_status_replicas_available{deployment=\"wanderlust-deployment\"})",
          "legendFormat": "Available Pods",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Pod Restarts (Last 1 Hour)",
      "description": "Tracks unexpected container restarts. A spike indicates uncaught exceptions, application crashes, failed health checks, or Linux Out-Of-Memory (OOMKilled) events.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"default\", pod=~\"wanderlust-.*\"}[1h]))",
          "legendFormat": "Restarts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Total App Memory Used",
      "description": "Total physical RAM currently allocated and actively held across all running Wanderlust application containers.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"default\", pod=~\"wanderlust-.*\", container!=\"\"})",
          "legendFormat": "Total RAM",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 4,
      "title": "Cluster Ready Nodes",
      "description": "Number of AWS EC2 worker instances in the EKS node group with healthy Kubelet heartbeats (Ready status).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "Nodes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Pod CPU Usage (Cores)",
      "description": "Real-time CPU cores utilized by each Wanderlust pod. Used to monitor application performance under load and detect CPU throttling against configured limits.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"default\", pod=~\"wanderlust-.*\", container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "title": "Pod Memory Usage (Working Set)",
      "description": "Actual memory (RAM) working set consumed by each pod. Essential for detecting Node.js memory leaks before hitting the 512Mi limit.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"default\", pod=~\"wanderlust-.*\", container!=\"\"}) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "bytes"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "AWS EKS Worker Nodes (USE Method)",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Node CPU Utilization (%)",
      "description": "Percentage of total compute capacity in use on each EC2 worker instance (100% minus idle time). Warns engineers if nodes need horizontal scaling.",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Node Memory Utilization (%)",
      "description": "Percentage of physical RAM consumed across each EC2 worker node. High memory saturation forces the OS kernel to trigger node-level OOM evictions.",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 14 },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Node Disk Space Used (%)",
      "description": "Storage capacity consumed on the root EBS volume. If disk reaches 85-90%, Kubelet enters DiskPressure state and evicts running pods.",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 14 },
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Pod Network Traffic (Rx / Tx)",
      "description": "Incoming (Rx) and outgoing (Tx) network bandwidth processed by each Wanderlust pod. Helps track inbound user requests and outbound database/CDN transfers.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"default\", pod=~\"wanderlust-.*\"}[5m])) by (pod)",
          "legendFormat": "Rx (Inbound): {{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"default\", pod=~\"wanderlust-.*\"}[5m])) by (pod)",
          "legendFormat": "Tx (Outbound): {{pod}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "binBps"
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["wanderlust", "kubernetes", "eks", "production"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "browser",
  "title": "Wanderlust App & EKS Cluster Overview",
  "version": 2
}
